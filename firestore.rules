rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if requester is Admin by Email or Role
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email.matches('.*@basechaninternational\\.com$') ||
        request.auth.token.email.matches('.*\\.basechaninternational@gmail\\.com$') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN_GOVERNANCE')
      );
    }

    // Helper: Basic active session check
    function isAuthenticated() {
      return request.auth != null;
    }

    // ── Global Catch-all for Admins ──
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // ── Standard User Access ──
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update, delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());

      match /{allPaths=**} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
    }

    // ── Public/Authenticated Read Collections ──
    match /system_config/{doc=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Fallback for other collections
    match /{collectionId}/{docId} {
       allow read, write: if isAuthenticated() && (
         isAdmin() ||
         (resource != null && resource.data.userId == request.auth.uid) ||
         (request.method == 'create')
       );
    }
  }
}
