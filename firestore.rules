rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. User Profiles & Sub-collections
    // Allow users to manage their own records
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Allow authenticated staff/admins to read all user records (Simplified check for now)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // Ideally restrict via custom claims
    }

    // 2. Global System Metrics & Config
    match /system/{doc=**} {
      allow read, write: if request.auth != null;
    }

    match /system_config/{doc=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // 3. Top-Up Requests & Financials
    match /topup_requests/{doc=**} {
      allow read, write: if request.auth != null;
    }

    match /financial_accounts/{doc=**} {
      allow read, write: if request.auth != null;
    }

    match /pof_evaluations/{doc=**} {
      allow read, write: if request.auth != null;
    }

    // 4. Governance & Communication
    match /notifications/{doc=**} {
      allow read, write: if request.auth != null;
    }

    match /audit_logs/{doc=**} {
      allow read, create: if request.auth != null;
    }

    match /support_messages/{doc=**} {
      allow read, write: if request.auth != null;
    }

    match /liquidity_requests/{doc=**} {
      allow read, write: if request.auth != null;
    }
  }
}
