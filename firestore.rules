rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /topup_requests/{requestId} {
      allow read, create, update: if request.auth != null;
    }
    match /system/storage_metrics {
      allow read, write: if request.auth != null;
    }
    match /pof_evaluations/{evalId} {
      allow read, write: if request.auth != null;
    }
    match /financial_accounts/{accId} {
      allow read, write: if request.auth != null;
    }
    match /notifications/{notifId} {
      allow read, write: if request.auth != null;
    }
    match /audit_logs/{logId} {
      allow read, create: if request.auth != null;
    }
    match /liquidity_requests/{reqId} {
      allow read, write: if request.auth != null;
    }
    match /system_config/{configId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // Ideally restrict to admin role
    }
  }
}
