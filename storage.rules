rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper: Verify user is active or Admin
    function isActive() {
      let userDoc = firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
      return request.auth != null &&
             (
               request.auth.token.email.matches('.*@basechaninternational\\.com$') ||
               request.auth.token.email.matches('.*\\.basechaninternational@gmail\\.com$') ||
               userDoc.data.role in ['ADMIN_GOVERNANCE', 'COUNSELOR', 'STAFF_AUDITOR'] ||
               (
                 (!('isArchived' in userDoc.data) || userDoc.data.isArchived == false) &&
                 (!('hardDeleted' in userDoc.data) || userDoc.data.hardDeleted == false)
               )
             );
    }

    match /{allPaths=**} {
      allow read, write: if request.auth != null && isActive();
      allow list: if request.auth != null && isActive();
    }
  }
}
