rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow students to upload and read their own documents
    match /student_documents/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.role == 'ADMIN_GOVERNANCE' ||
        request.auth.token.role == 'COUNSELOR' ||
        request.auth.token.role == 'STAFF_AUDITOR'
      );
      allow write: if request.auth != null && request.auth.uid == userId &&
                   request.resource.size < 10 * 1024 * 1024 && // 10MB limit
                   (request.resource.contentType.matches('image/.*') ||
                    request.resource.contentType == 'application/pdf' ||
                    request.resource.contentType == 'application/msword' ||
                    request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document');
    }

    // Allow users and staff to read generated mandate packages
    match /mandate_packages/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.role == 'ADMIN_GOVERNANCE' ||
        request.auth.token.role == 'COUNSELOR' ||
        request.auth.token.role == 'STAFF_AUDITOR'
      );
      // Write is usually handled by Admin SDK (server), but we can allow it for consistency if needed.
      // For now, only read access for clients.
      allow write: if false;
    }

    // Default: Deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
